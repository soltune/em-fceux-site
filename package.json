{
  "name": "em-fceux-site",
  "version": "1.2.0",
  "private": true,
  "description": "em-fceux website.",
  "homepage": "https://tsone.kapsi.fi/em-fceux/",
  "author": "Valtteri Heikkilä",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git@bitbucket.org:tsone/em-fceux-site.git"
  },
  "bugs": {
    "url": "https://bitbucket.org/tsone/em-fceux/issues?status=new&status=open"
  },
  "keywords": [
    "emscripten",
    "emulator",
    "famicom",
    "fceux",
    "gamepad",
    "gamepad api",
    "nes",
    "nintendo",
    "wasm",
    "webassembly",
    "webaudio",
    "web audio",
    "webgl"
  ],
  "scripts": {
    "build": "npm run prettier && webpack --mode=production",
    "clean": "rm -rf dist",
    "dev:setup": "npm link ../fceux/src/drivers/em",
    "prettier": "prettier --print-width 80 --write *.md && prettier --write \"{,!(dist|node_modules)/**/}*.{ts,js,css}\"",
    "start": "webpack-dev-server --mode=development"
  },
  "devDependencies": {
    "em-fceux": "^2.1.0",
    "html-webpack-deploy-plugin": "^3.0.0",
    "html-webpack-plugin": "^5.5.0",
    "prettier": "^2.6.2",
    "ts-loader": "^9.3.0",
    "typescript": "^4.7.2",
    "webpack": "^5.72.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.9.1"
  }
}
